import json
import re
import glob
import pandas as pd

# ===== 설정 =====
INPUT_GLOB = "data/*.json"      # 크롤링한 JSON 파일들이 있는 폴더
OUTPUT_JSON = "clean.json"      # 전처리 결과 (웹사이트용)
OUTPUT_CSV = "clean.csv"        # 전처리 결과 (엑셀 확인용)
MIN_BODY_LEN = 100              # 이보다 짧은 글은 제외


# ===== 텍스트 정리 =====
def clean_text(s):
    s = re.sub(r"[\U00010000-\U0010ffff\u2600-\u27bf]", "", s)  # 이모지
    s = re.sub(r"[ㅎㅋㅠㅜ]{2,}", "", s)                          # ㅎㅎ, ㅋㅋ, ㅠㅠ
    s = re.sub(r"\.{2,}", ".", s)                                # .. → .
    s = re.sub(r"[!?]{2,}", lambda m: m.group()[0], s)           # !! → !
    s = re.sub(r"\s+", " ", s)
    return s.strip()


# ===== 정보 추출 =====
def extract_hours(text):
    m = re.search(r"영업시간\s*([0-9]{1,2}:[0-9]{2}\s*[-~]\s*[0-9]{1,2}:[0-9]{2})", text)
    return m.group(1) if m else None


def extract_prices(text):
    return [int(p.replace(",", "")) for p in re.findall(r"([0-9][0-9,]{3,})\s*원", text)]


def extract_region(title):
    m = re.search(r"(\S+\s?\S*동)\s*맛집", title)  # "군산 나운동 맛집" 패턴
    return m.group(1) if m else None


def is_sponsored(text):
    keywords = ["제공받", "소정의 원고료", "체험단", "협찬", "광고"]
    return any(k in text for k in keywords)


# ===== 메인 =====
def main():
    paths = glob.glob(INPUT_GLOB)
    print(f"파일 {len(paths)}개 발견")

    rows = []
    failed = []

    for path in paths:
        # 파일 읽기 (깨진 파일은 건너뜀)
        try:
            with open(path, encoding="utf-8") as f:
                d = json.load(f)
        except Exception as e:
            failed.append((path, str(e)))
            continue

        # 필수 필드 확인
        if not all(k in d for k in ("title", "url", "body")):
            failed.append((path, "필수 필드 없음"))
            continue

        # body 정리
        body = d["body"]
        if isinstance(body, str):          # 혹시 문자열로 저장된 경우 대비
            body = body.split("\n")

        lines = [l.strip() for l in body if l and l.strip()]   # 빈 줄 제거
        if lines and lines[0] == d["title"]:                    # 제목 중복 제거
            lines = lines[1:]
        lines = list(dict.fromkeys(lines))                      # 중복 줄 제거(순서 유지)
        lines = [clean_text(l) for l in lines]
        lines = [l for l in lines if len(l) > 1]                # 너무 짧은 줄 제거

        text = " ".join(lines)

        rows.append({
            "blog_id": d.get("blog_id"),
            "title": d["title"],
            "published_at": d.get("published_at"),
            "url": d["url"],
            "body": text,
            "region": extract_region(d["title"]),
            "hours": extract_hours(text),
            "prices": extract_prices(text),
            "sponsored": is_sponsored(text),
        })

    df = pd.DataFrame(rows)

    if df.empty:
        print("처리된 데이터가 없어요. 경로와 파일 형식을 확인하세요.")
        return

    # 날짜 변환
    df["published_at"] = pd.to_datetime(df["published_at"], errors="coerce", utc=True)
    df["published_at"] = df["published_at"].dt.tz_convert("Asia/Seoul").dt.tz_localize(None)

    # 중복/짧은 글 제거
    before = len(df)
    df = df.drop_duplicates(subset="url")
    df = df[df["body"].str.len() > MIN_BODY_LEN]
    df = df.reset_index(drop=True)

    # 저장
    df.to_json(OUTPUT_JSON, orient="records", force_ascii=False, indent=2, date_format="iso")
    df.to_csv(OUTPUT_CSV, index=False, encoding="utf-8-sig")

    # 결과 요약
    print(f"읽기 실패: {len(failed)}개")
    for p, e in failed:
        print("  -", p, e)
    print(f"전처리 전 {before}개 → 후 {len(df)}개")
    print(f"저장 완료: {OUTPUT_JSON}, {OUTPUT_CSV}")
    print("\n[샘플 3개]")
    print(df[["title", "region", "hours", "prices", "sponsored"]].head(3).to_string())


if __name__ == "__main__":
    main()
